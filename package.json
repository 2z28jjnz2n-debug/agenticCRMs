{
	"name": "crm",
	"private": true,
	"license": "MIT",
	"version": "1.16.0",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
		"build": "turbo run build",
		"audit": "bun audit",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:slop": "vp lint",
		"lint:dead": "knip --no-progress",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test --concurrency=1",
		"auth:generate": "turbo run auth:generate",
		"db:deploy": "turbo run db:deploy",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:push": "turbo run db:push",
		"db:reset": "turbo run db:reset",
		"db:seed": "turbo run db:seed",
		"db:studio": "turbo run db:studio",
		"db:test": "bun --env-file=.env run --filter=@crm/db db:test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@oxlint/plugins": "1.89.0",
		"knip": "6.42.1",
		"turbo": "^2.11.9",
		"typescript": "5.9.2",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "bun@1.4.0",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0"
		}
	},
	"overrides": {
		"@better-auth/core": "1.7.14",
		"@nestjs/swagger>js-yaml": "5.4.2",
		"auth>@mrleebo/prisma-ast": "0.16.0",
		"eve>undici": "8.12.3",
		"guarded-fetch>undici": "7.30.1",
		"@ai-sdk/provider-utils>undici": "7.30.1",
		"@vercel/blob>undici": "6.29.1",
		"@hono/node-server": "2.1.5",
		"body-parser": "2.4.0",
		"dompurify": "3.4.17",
		"fast-uri": "3.1.9",
		"ip-address": "10.7.5",
		"multer": "2.5.0",
		"qs": "6.16.2",
		"@vercel/cli-config>zod": "4.6.7"
	},
	"catalog": {
		"vite-plus": "1.3.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
